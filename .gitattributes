# Auto detect text files and perform LF normalization
* text=auto
# 평가 세트는 작업 공간에서도 줄 끝을 LF로(P 세트 봉인 해시가 체크아웃 때 바뀌지 않게)
evaluation/*.csv text eol=lf
# 판정 후 공개한 대응표도 해시를 적어 두므로 줄 끝을 LF로
evaluation/results/*-blind-key-*.json text eol=lf
# 프롬프트 파일은 해시(prompt_sha256)를 적어 두므로 줄 끝을 LF로
ingest/prompts/*.txt text eol=lf
# 2차 계획은 채팅 Claude가 준 SHA-256과 대조하므로 줄 끝을 LF로
docs/superpowers/plans/2026-11-21-phase2-model-request-plan.md text eol=lf
