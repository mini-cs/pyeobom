OPENAI_API_KEY=
DATABASE_URL=
OPENAI_EMBED_MODEL=text-embedding-3-small
# 임베딩 결과 길이(dimensions). 비우면 요청에 넣지 않는다(지금 운영 그대로). large를 1536으로 줄일 때만 1536
OPENAI_EMBED_DIMENSIONS=
OPENAI_CHAT_MODEL=gpt-6-luna
# 조각 설명(v1.95)을 쓰는 모델(적재 전용). 비면 조각 설명을 쓰지 않음(지금 운영)
CHUNK_CONTEXT_MODEL=
EMBED_DIM=1536
TOP_K=5
MAX_QUESTION_LEN=500
OPENAI_MAX_OUTPUT_TOKENS=600
OPENAI_REASONING_EFFORT=low
PROMPT_VERSION=v1
SEARCH_MODE=vector
FORCE_FAIL=
# Langfuse 추적(로컬 측정 전용, Vercel에는 넣지 않음). 비워 두면 추적하지 않는다
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
# 부하 측정(Locust·Promptfoo, 로컬 전용): 미리보기 주소와 Vercel 자동화용 보호 우회 값(헤더로만 보냄)
PREVIEW_URL=
VERCEL_AUTOMATION_BYPASS_SECRET=
# 질문 바꾸기(계획 2). 비워 두면 모델은 답변 모델, 시간 제한 5초, 출력 300토큰, 추론 강도 none
REWRITE_MODEL=
REWRITE_TIMEOUT_S=
REWRITE_MAX_OUTPUT_TOKENS=
REWRITE_REASONING_EFFORT=
# 첫 질문 다듬기(v1.96). 비면 첫 질문 다듬기를 하지 않음(지금 운영)
REFINE_MODEL=
# 2차 요청 흐름(Task 5). 공개 값(URL·공개 키)만 /api/public-config로 화면에 내려간다
SUPABASE_URL=
# Supabase 공개 키(sb_publishable_…). 이름은 옛 anon 그대로
SUPABASE_ANON_KEY=
# Supabase 비밀 키(sb_secret_…, 서버 전용). 이름은 옛 service 그대로
SUPABASE_SERVICE_KEY=
RESEND_API_KEY=
NOTIFY_WEBHOOK_SECRET=
OPERATOR_EMAIL=
# 보내는 주소 예: 펴봄 <noreply@mail.pyeobom.help>
MAIL_FROM=
