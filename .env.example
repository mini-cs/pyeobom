OPENAI_API_KEY=
DATABASE_URL=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-6-luna
EMBED_DIM=1536
TOP_K=5
MAX_QUESTION_LEN=500
OPENAI_MAX_OUTPUT_TOKENS=600
OPENAI_REASONING_EFFORT=low
PROMPT_VERSION=v1
SEARCH_MODE=vector
FORCE_FAIL=
# Langfuse 추적(로컬 측정 전용, Vercel에는 넣지 않음). 비워 두면 추적하지 않는다
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
# 부하 측정(Locust·Promptfoo, 로컬 전용): 미리보기 주소와 Vercel 자동화용 보호 우회 값(헤더로만 보냄)
PREVIEW_URL=
VERCEL_AUTOMATION_BYPASS_SECRET=
# 질문 바꾸기(계획 2). 비워 두면 모델은 답변 모델, 시간 제한 5초, 출력 120토큰
REWRITE_MODEL=
REWRITE_TIMEOUT_S=
REWRITE_MAX_OUTPUT_TOKENS=
